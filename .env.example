# Photo Vault web — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Only PUBLIC configuration may live here (VITE_* is inlined into the bundle).
# Never put Google secrets, R2 credentials, or session secrets here.
#
# Optional absolute API origin used only when the SPA is NOT served on the same
# origin as the API. Leave blank for same-origin: in dev the Vite proxy forwards
# /auth and /v1 to http://localhost:3000; in production Caddy serves the build
# and proxies both paths.
VITE_API_BASE_URL=
